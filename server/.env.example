# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGINS=*

# ─── Redis (local) ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# For Redis with password: redis://:yourpassword@localhost:6379
# For TLS (e.g. Redis Cloud): rediss://user:pass@host:6380
REDIS_KEY_PREFIX=rtc:

# ─── TTL (seconds) ────────────────────────────────────────────────────────────
MESSAGE_TTL_SECONDS=604800
CALL_TTL_SECONDS=300
PRESENCE_TTL_SECONDS=60
NOTIFICATION_TTL_SECONDS=86400

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_EVENTS=120

# ─── Heartbeat ────────────────────────────────────────────────────────────────
HEARTBEAT_INTERVAL_MS=25000
HEARTBEAT_TIMEOUT_MS=60000

# ─── Call Settings ────────────────────────────────────────────────────────────
CALL_RING_TIMEOUT_MS=60000

# ─── Typing ───────────────────────────────────────────────────────────────────
TYPING_AUTO_STOP_MS=5000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Projects (Multi-Tenant) ──────────────────────────────────────────────────
# JSON array – add one entry per application that will connect to this server
PROJECTS=[{"projectId":"app1","apiKey":"your-api-key-1","jwtSecret":"your-jwt-secret-1"},{"projectId":"app2","apiKey":"your-api-key-2","jwtSecret":"your-jwt-secret-2"}]
